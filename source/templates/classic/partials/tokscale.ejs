<% if (plugins.tokscale) { %>
  <section>
    <h2 class="field">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path fill-rule="evenodd" d="M7.775 3.275a.75.75 0 001.06 1.06l1.25-1.25a2 2 0 112.83 2.83l-2.5 2.5a2 2 0 01-2.83 0 .75.75 0 00-1.06 1.06 3.5 3.5 0 004.95 0l2.5-2.5a3.5 3.5 0 00-4.95-4.95l-1.25 1.25zm-4.69 9.64a2 2 0 010-2.83l2.5-2.5a2 2 0 012.83 0 .75.75 0 001.06-1.06 3.5 3.5 0 00-4.95 0l-2.5 2.5a3.5 3.5 0 004.95 4.95l1.25-1.25a.75.75 0 00-1.06-1.06l-1.25 1.25a2 2 0 01-2.83 0z"></path></svg>
      Tokscale statistics <% if (plugins.tokscale.user?.username) { %>for <%= plugins.tokscale.user.username %><% } %>
    </h2>
    <% if (plugins.tokscale.error) { %>
      <div class="row">
        <section>
          <div class="field error">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path fill-rule="evenodd" d="M2.343 13.657A8 8 0 1113.657 2.343 8 8 0 012.343 13.657zM6.03 4.97a.75.75 0 00-1.06 1.06L6.94 8 4.97 9.97a.75.75 0 101.06 1.06L8 9.06l1.97 1.97a.75.75 0 101.06-1.06L9.06 8l1.97-1.97a.75.75 0 10-1.06-1.06L8 6.94 6.03 4.97z"></path></svg>
            <%= plugins.tokscale.error.message %>
          </div>
        </section>
      </div>
    <% } else { %>
      <% const stats = plugins.tokscale.stats ?? {} %>
      <% const user = plugins.tokscale.user ?? {} %>
      <% const showOverview = plugins.tokscale.sections?.includes("overview") && [stats.totalTokens, user.rank, stats.totalCost, stats.submissionCount].some(Number.isFinite) %>
      <% if (showOverview) { %>
        <div class="row">
          <section>
            <% if (Number.isFinite(stats.totalTokens)) { %>
              <div class="field">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path d="M8.75 1.75a.75.75 0 00-1.5 0v.5a4.75 4.75 0 00-4.5 4.735.75.75 0 001.5.03A3.25 3.25 0 017.25 3.782V8.5h-3a.75.75 0 000 1.5h3v5.25a.75.75 0 001.5 0V10h3a.75.75 0 000-1.5h-3V3.782a3.25 3.25 0 012.75 3.233.75.75 0 001.5-.03 4.75 4.75 0 00-4.5-4.735v-.5z"></path></svg>
                Total tokens: <%= f(stats.totalTokens) %>
              </div>
            <% } %>
            <% if (Number.isFinite(user.rank)) { %>
              <div class="field">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path fill-rule="evenodd" d="M8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13zM0 8a8 8 0 1116 0A8 8 0 0 0 0 8zm11.78-1.72a.75.75 0 00-1.06-1.06L7.25 8.69 5.28 6.72a.75.75 0 00-1.06 1.06l2.5 2.5a.75.75 0 001.06 0l4-4z"></path></svg>
                Rank: #<%= user.rank %>
              </div>
            <% } %>
          </section>
          <section>
            <% if (Number.isFinite(stats.totalCost)) { %>
              <div class="field">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path d="M10.561 8.073a6.005 6.005 0 1 3.432 5.142.75.75 0 1 1-1.498.07 4.5 4.5 0 0 0-8.99 0 .75.75 0 0 1-1.498-.07 6.004 6.004 0 0 1 3.431-5.142 3.999 3.999 0 1 1 5.123 0ZM10.5 5a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"></path></svg>
                Total cost: $<%= stats.totalCost.toFixed(2) %>
              </div>
            <% } %>
            <% if (Number.isFinite(stats.submissionCount)) { %>
              <div class="field">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path d="M4.75 0a.75.75 0 0 1 .75.75V2h5V.75a.75.75 0 0 1 1.5 0V2h1.25c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25V3.75C1 2.784 1.784 2 2.75 2H4V.75A.75.75 0 0 1 4.75 0ZM2.5 7.5v6.75c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25V7.5Zm10.75-4H2.75a.25.25 0 0 0-.25.25V6h11V3.75a.25.25 0 0 0-.25-.25Z"></path></svg>
                Submissions: <%= stats.submissionCount %><% if (Number.isFinite(stats.activeDays)) { %> (<%= stats.activeDays %> active days)<% } %>
              </div>
            <% } %>
          </section>
        </div>
      <% } %>
      <% if ((plugins.tokscale.sections?.includes("models"))&&(plugins.tokscale.models?.length)) { %>
        <div class="tokscale models">
          <h2 class="field">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path fill-rule="evenodd" d="M7.775 3.275a.75.75 0 001.06 1.06l1.25-1.25a2 2 0 112.83 2.83l-2.5 2.5a2 2 0 01-2.83 0 .75.75 0 00-1.06 1.06 3.5 3.5 0 004.95 0l2.5-2.5a3.5 3.5 0 00-4.95-4.95l-1.25 1.25zm-4.69 9.64a2 2 0 010-2.83l2.5-2.5a2 2 0 012.83 0 .75.75 0 001.06-1.06 3.5 3.5 0 00-4.95 0l-2.5 2.5a2 2 0 004.95 4.95l1.25-1.25a.75.75 0 00-1.06-1.06l-1.25 1.25a2 2 0 01-2.83 0z"></path></svg>
            Top models
          </h2>
          <div class="row fill-width">
            <section class="categories">
              <% for (const {name, cost, percentage} of plugins.tokscale.models) { %>
                <div class="category column">
                  <% if (Number.isFinite(percentage) || Number.isFinite(cost)) { %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="50" height="50" class="gauge">
                      <circle class="gauge-base" r="53" cx="60" cy="60"></circle>
                      <% if (Number.isFinite(percentage)) { %><circle class="gauge-arc" transform="rotate(-90 60 60)" r="53" cx="60" cy="60" stroke-dasharray="<%= percentage * 329 %> 329"></circle><% } %>
                      <% if (Number.isFinite(percentage)) { %><text x="60" y="50" dominant-baseline="central" style="font-size: 16px"><%= (percentage * 100).toFixed(1) %>%</text><% } %>
                      <% if (Number.isFinite(cost)) { %><text x="60" y="80" dominant-baseline="central" class="secondary" style="font-size: 14px">$<%= cost.toFixed(0) %></text><% } %>
                    </svg>
                  <% } %>
                  <span class="title"><%= name %></span>
                </div>
              <% } %>
            </section>
          </div>
        </div>
      <% } %>
      <% if ((plugins.tokscale.sections?.includes("recent"))&&(typeof plugins.tokscale.lastSubmit === "string")&&(Number.isFinite(Date.parse(plugins.tokscale.lastSubmit)))) { %>
        <div class="tokscale recent">
          <h2 class="field">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path d="M4.75 0a.75.75 0 0 1 .75.75V2h5V.75a.75.75 0 0 1 1.5 0V2h1.25c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25V3.75C1 2.784 1.784 2 2.75 2H4V.75A.75.75 0 0 1 4.75 0ZM2.5 7.5v6.75c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25V7.5Zm10.75-4H2.75a.25.25 0 0 0-.25.25V6h11V3.75a.25.25 0 0 0-.25-.25Z"></path></svg>
            Last activity
          </h2>
          <div class="field">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16"><path d="M4.75 0a.75.75 0 0 1 .75.75V2h5V.75a.75.75 0 0 1 1.5 0V2h1.25c.966 0 1.75.784 1.75 1.75v10.5A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25V3.75C1 2.784 1.784 2 2.75 2H4V.75A.75.75 0 0 1 4.75 0ZM2.5 7.5v6.75c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25h10.5a.25.25 0 0 0 .25-.25V7.5Zm10.75-4H2.75a.25.25 0 0 0-.25.25V6h11V3.75a.25.25 0 0 0-.25-.25Z"></path></svg>
            Last submission: <%= f.date(new Date(plugins.tokscale.lastSubmit), {date:true, timeZone:config.timezone?.name}) %>
          </div>
        </div>
      <% } %>
    <% } %>
  </section>
<% } %>

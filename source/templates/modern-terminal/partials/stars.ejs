<% if (plugins.stars) { %>
  <% if (plugins.stars.error) { -%>
    <span class="error"><%= plugins.stars.error.message %></span>
  <% } else { const repositories = Array.isArray(plugins.stars.repositories) ? plugins.stars.repositories : [] -%>
    <% if (repositories.length) { -%>
      <ul class="terminal-list">
      <% for (const {node: repository} of repositories) { -%>
        <li><div><%= repository.nameWithOwner || "unknown" %> <span class="tui-status">★ <%= f(repository.stargazerCount || 0) %></span></div>
        <% if (repository.primaryLanguage?.name) { %><div class="tui-detail"><span style="--data-color:<%= repository.primaryLanguage.color ?? 'var(--color-muted)' %>;color:var(--data-color)"><%= repository.primaryLanguage.name %></span></div><% } %>
        </li>
      <% } -%>
      </ul>
    <% } else { -%>
      <p class="empty">No recently starred repositories</p>
    <% } -%>
  <% } -%>
<% } %>

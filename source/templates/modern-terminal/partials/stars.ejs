<% if (plugins.stars) { %>
  <div class="stdin"><%- meta.$ %> gh starred list --user <%= user.login %></div>
  <div class="stdout">
    <% if (plugins.stars.error) { -%>
      <span class="error"><%= plugins.stars.error.message %></span>
    <% } else { -%>
      <% 
        const all = Array.isArray(plugins.stars.repositories) ? plugins.stars.repositories : [];
        const repos = all.slice(0, 10);
        const sample = repos.map(r => r.node || {});
        const nameWidth = sample.length ? Math.max(...sample.map(r => (r.nameWithOwner || '').length), 20) : 20;
        const starsWidth = sample.length ? Math.max(...sample.map(r => String(r.stargazerCount || 0).length), 2) : 2;
      %>
      <pre><% for (const {node:repository} of repos) { %>
<%= (repository.nameWithOwner || '').padEnd(nameWidth) %>  <%= String(repository.stargazerCount || 0).padStart(starsWidth) %>  <%= repository.primaryLanguage ? repository.primaryLanguage.name : '' %>
      <% } %></pre>
    <% } -%>
  </div>
<% } %>

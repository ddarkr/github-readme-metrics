<% if (plugins.discussions) { %>
  <div class="stdin"><%- meta.$ %> gh discussion list --user <%= user.login %></div>
  <div class="stdout">
  <% if (plugins.discussions.error) { -%>
    <span class="error"><%= plugins.discussions.error.message %></span>
  <% } else { -%>
    <% 
      const started = plugins.discussions.started ?? 0;
      const comments = plugins.discussions.comments ?? 0;
      const answers = plugins.discussions.answers ?? 0;
      const upvDiscussions = plugins.discussions.upvotes?.discussions ?? 0;
      const upvComments = plugins.discussions.upvotes?.comments ?? 0;
      const categories = (plugins.discussions.categories && plugins.discussions.categories.stats) ? plugins.discussions.categories.stats : {};
      const catLimit = plugins.discussions.display && plugins.discussions.display.categories ? (plugins.discussions.display.categories.limit || Object.keys(categories).length) : 0;
    %>
    Discussions: <%= started %> started
    Comments: <%= comments %>  Answers: <%= answers %>
    Upvotes (discussions): <%= upvDiscussions %>  Upvotes (comments): <%= upvComments %>

    <% if (catLimit && Object.keys(categories).length) { %>
      Categories:
      <% for (const [name, count] of Object.entries(categories).slice(0, catLimit)) { %>
        - <%= name %>: <%= count %>
      <% } %>
    <% } %>
  <% } -%>
  </div>
<% } %>

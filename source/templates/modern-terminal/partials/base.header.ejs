<% if (base.header) { %>
<dl class="terminal-kv">
<dt><%= q.repo ? "Repository" : "Name" %></dt><dd><%= user.name || user.login %></dd>
<dt><%= q.repo ? "Created" : "Joined GitHub" %></dt><dd><%= computed.registration %></dd>
<% if (q.repo) { %>
<dt>Deployments</dt><dd><%= repo.deployments.totalCount %></dd>
<dt>Environments</dt><dd><%= repo.environments.totalCount %></dd>
<dt>Contributors</dt><dd><%= repo.contributors.totalCount %></dd>
<% if (repo.actionUsersCount != null) { %><dt>Action users</dt><dd><%= repo.actionUsersCount %></dd><% } %>
<% } else if (account === "user") { %>
<dt>Contributed repos</dt><dd><%= user.repositoriesContributedTo.totalCount %></dd>
<dt>Followers</dt><dd><%= user.followers.totalCount %></dd>
<% if (user.isHireable) { %><dt>Availability</dt><dd>Available for hire</dd><% } %>
<% } else if (account === "organization") { %>
<dt>Members</dt><dd><%= user.membersWithRole.totalCount %></dd>
<% if (user.isVerified) { %><dt>Organization</dt><dd>Verified</dd><% } %>
<% } %>
<% if (!q.repo && user.location) { %><dt>Location</dt><dd><%= user.location %></dd><% } %>
</dl>
<% } %>

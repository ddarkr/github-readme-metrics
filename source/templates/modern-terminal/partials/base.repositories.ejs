<% if (base.repositories) { %>
<dl class="terminal-kv">
<% if (!q.repo) { %><dt>Repositories</dt><dd><%= Number.isFinite(user.repositories.totalCount) ? user.repositories.totalCount : "Unavailable" %><% if (computed.repositories.forked) { %> · <%= computed.repositories.forked %> forked<% } %></dd><% } %>
<dt>Disk usage</dt><dd><%= Number.isFinite(user.repositories.totalDiskUsage) ? computed.diskUsage : "Unavailable" %></dd>
<dt>Stargazers</dt><dd><%= computed.repositories.stargazers %></dd>
<dt>Forks</dt><dd><%= computed.repositories.forks %></dd>
<dt>Watchers</dt><dd><%= computed.repositories.watchers %></dd>
<dt>Releases</dt><dd><%= computed.repositories.releases %></dd>
<% if (!q.repo) { %><dt>Packages</dt><dd><%= user.packages.totalCount %></dd><% } %>
<dt>Sponsors</dt><dd><%= user.sponsorshipsAsMaintainer.totalCount %></dd>
<% if (q.repo) { %><dt>License</dt><dd><%= repo.licenseInfo ? f.license(repo.licenseInfo) : "No license provided" %></dd>
<% } else if (computed.licenses.favorite.length) { %><dt>Preferred license</dt><dd><%= f.license(computed.licenses.about[computed.licenses.favorite]) %></dd><% } %>
<% if (plugins.lines?.sections?.includes("base")) { %>
<dt>Lines changed</dt><dd><% if (plugins.lines.error) { %><span class="error"><%= plugins.lines.error.message %></span><% } else { %><span class="diff">+<%= f(plugins.lines.added + plugins.lines.changed) %></span> <span class="deleted">-<%= f(plugins.lines.deleted + plugins.lines.changed) %></span><% } %></dd>
<% } %>
</dl>
<% } %>

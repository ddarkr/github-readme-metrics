<% if (plugins["rss"]) { %>
<% if (plugins["rss"].error) { %>
<p class="error"><%= plugins["rss"].error.message %></p>
<% } else { %>
<p class="terminal-subtitle"><%= plugins.rss.source %></p>
<% if (plugins.rss.feed.length) { %><ul class="terminal-list"><% for (const {title, date} of plugins.rss.feed) { %><li><b><%= title %></b><p class="terminal-subtitle"><%= f.date(new Date(date), {date:true, timeZone:config.timezone?.name}) %></p></li><% } %></ul><% } else { %><p class="empty">No entries in this RSS feed.</p><% } %>
<% } %>
<% } %>

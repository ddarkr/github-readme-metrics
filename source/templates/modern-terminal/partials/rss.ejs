<% if (plugins.rss) { %>
<div class="stdin"><%- meta.$ %> rss fetch <%= plugins.rss?.source ?? "" %></div><%# -%>
<div class="stdout"><%# -%>
<% if (plugins.rss.error) { -%>
<span class="error"><%= plugins.rss.error.message %></span><%# -%>
<% } else { -%>
  <% if (plugins.rss.feed && plugins.rss.feed.length) { -%>
    <% for (const {title, date} of plugins.rss.feed) { -%>
      <% const t = String(title || "").padEnd(60); -%>
      <% const d = f.date(new Date(date), {date:true, timeZone:config.timezone?.name}); -%>
%>
<%= t %> <span style="color:#888"><%= d %></span>
    <% } -%>
  <% } else { -%>
    Empty RSS feed
  <% } -%>
<% } -%>
</div><% } %>

<% if (plugins["stackoverflow"]) { %>
<% if (plugins["stackoverflow"].error) { %>
<p class="error"><%= plugins["stackoverflow"].error.message %></p>
<% } else { %>
<dl class="terminal-kv">
<% for (const [key, label] of [["reputation", "Reputation"], ["questions", "Questions"], ["answers", "Answers"], ["comments", "Comments"], ["badges", "Badges"]]) { %><dt><%= label %></dt><dd><%= f(plugins.stackoverflow.user[key]) %></dd><% } %>
</dl>
<% for (const section of plugins.stackoverflow.sections) { const entries = plugins.stackoverflow[section]; if (!entries?.length) continue %>
<h3><%= {"questions-recent":"Recent questions", "questions-top":"Top questions", "answers-recent":"Recent answers", "answers-top":"Top answers"}[section] %></h3>
<ul class="terminal-list">
<% for (const entry of entries) { %>
<li><b><%- entry.type === "question" ? entry.title : entry.question?.title %></b>
<% if (entry.type === "question") { %><p class="terminal-subtitle"><%= entry.tags.join(", ") %></p><% } %>
<div class="prose <%= plugins.stackoverflow.lines ? 'clamped' : '' %>" style="--line-limit:<%= plugins.stackoverflow.lines %>"><%- entry.body %></div>
<p class="terminal-subtitle"><%= f(entry.upvotes) %> upvotes · <%= f(entry.downvotes) %> downvotes · <%= f(entry.comments) %> comments · <%= entry.created %></p>
<% if (entry.type === "question") { %><p><%= f(entry.views) %> views · <%= f(entry.answers) %> answers</p><% } else if (entry.accepted) { %><p class="diff">Accepted answer</p><% } %>
</li>
<% } %>
</ul>
<% } %>
<% } %>
<% } %>

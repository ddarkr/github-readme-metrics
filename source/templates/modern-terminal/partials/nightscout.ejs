<% if (plugins["nightscout"]) { %>
<% if (plugins["nightscout"].error) { %>
<p class="error"><%= plugins["nightscout"].error.message %></p>
<% } else { %>
<% const last = plugins.nightscout.data.at(-1) %>
<% if (last) { %>
<p><b>Blood sugar: <%= last.sgv %> <%= last.arrowHumanReadable %></b><% if (last.alert) { %> · <%= last.alert %><% } %></p>
<div class="terminal-table">
<% for (const reading of plugins.nightscout.data) { %><div class="terminal-table__row"><span><%= reading.timeUTCHumanReadable %> UTC</span><span><%= reading.sgv %><% if (reading.alert) { %> · <%= reading.alert %><% } %></span></div><% } %>
</div>
<% } else { %><p class="empty">No readings returned by Nightscout.</p><% } %>
<% } %>
<% } %>

<% if (plugins.gists) { %>

  <% if (plugins.gists.error) { -%>
    <span class="error"><%= plugins.gists.error.message %></span>
  <% } else { -%>
    <div class="terminal-kv">
      <span class="terminal-kv__key">Gists</span><span class="terminal-kv__value"><b><%= plugins.gists.totalCount %></b></span>
      <span class="terminal-kv__key">Files</span><span class="terminal-kv__value"><%= plugins.gists.files %></span>
      <span class="terminal-kv__key">Comments</span><span class="terminal-kv__value"><%= plugins.gists.comments %></span>
      <span class="terminal-kv__key">Stars</span><span class="terminal-kv__value"><%= plugins.gists.stargazers %></span>
      <span class="terminal-kv__key">Forks</span><span class="terminal-kv__value"><%= plugins.gists.forks %></span>
    </div>
  <% } -%>

<% } %>

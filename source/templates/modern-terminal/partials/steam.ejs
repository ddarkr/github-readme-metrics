<% if (plugins["steam"]) { %>
<% if (plugins["steam"].error) { %>
<p class="error"><%= plugins["steam"].error.message %></p>
<% } else { %>
<% if (plugins.steam.sections.includes("player") && plugins.steam.player) { %>
<p class="identity"><%= plugins.steam.player.name %></p><p><%= plugins.steam.games.count %> games · <%= f(parseInt(plugins.steam.games.playtime)) %> hours played · level <%= plugins.steam.player.level %></p>
<% } %>
<% for (const section of ["most-played", "recently-played"]) { if (!plugins.steam.sections.includes(section)) continue; const games = plugins.steam.games[section] %>
<h3><%= section === "most-played" ? "Most played" : "Recently played" %></h3>
<% if (games.length) { %><ul class="terminal-list">
<% for (const game of games) { %><li><b><%= game.name %></b><p class="terminal-subtitle"><%= game.genres.join(", ") %></p><p><%= f(parseInt(game.playtime)) %> hours played<% if (game.played) { %> · last played <%= f.date(game.played * 1000, {date:true, timeZone:config.timezone?.name}) %><% } %></p>
<% if (game.rate?.total) { %><p><%= game.rate.achieved %>/<%= game.rate.total %> achievements unlocked</p><% } %>
<% if (game.achievements?.length) { %><ul><% for (const achievement of game.achievements.filter(({achieved}) => achieved)) { %><li><%= achievement.name %> · <%= achievement.description %><p class="terminal-subtitle"><%= f.date(achievement.unlocked * 1000, {date:true, timeZone:config.timezone?.name}) %></p></li><% } %></ul><% } %>
</li><% } %>
</ul><% } else { %><p class="empty">No games in this period.</p><% } %>
<% } %>
<% } %>
<% } %>

<% if (plugins["chess"]) { %>
<% if (plugins["chess"].error) { %>
<p class="error"><%= plugins["chess"].error.message %></p>
<% } else { %>
<p class="terminal-subtitle">Latest game from <%= plugins.chess.platform %></p>
<dl class="terminal-kv">
<% for (const color of ["White", "Black"]) { %><dt><%= color %></dt><dd><%= plugins.chess.meta[color] %><% if (plugins.chess.meta[`${color}Elo`]) { %> · <%= plugins.chess.meta[`${color}Elo`] %> Elo<% } %></dd><% } %>
<dt>Date</dt><dd><%= plugins.chess.meta.Date %></dd>
<dt>Result</dt><dd><%= plugins.chess.meta.Result %></dd>
</dl>
<h3>Moves</h3>
<% if (plugins.chess.moves.length) { %><ol class="terminal-list"><% for (const move of plugins.chess.moves) { %><li><%= move.color === "w" ? "White" : "Black" %> · <%= move.san %> <span class="terminal-subtitle">(<%= move.from %> → <%= move.to %>)</span></li><% } %></ol><% } else { %><p class="empty">No moves recorded.</p><% } %>
<% } %>
<% } %>

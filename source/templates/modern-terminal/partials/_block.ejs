<%# Content-only partials return empty output when disabled. This is the only section shell. %>
<% if (content) { const title = {"base.header": q.repo ? "Repository" : account === "organization" ? "Organization" : "Profile", "base.repositories": q.repo ? "Repository statistics" : "Repositories", "base.activity+community":"Activity and community", "16personalities":"Personality", "isocalendar":"Contribution streaks", "rss":"RSS feed", "tokscale":"Tokscale usage", "wakatime":"WakaTime", "followup":"Issues and pull requests", "lines":"Lines of code", "music":"Listening history", "starlists":"Star lists", "stars":"Recently starred", "stackoverflow":"Stack Overflow"}[partial] || `${partial.charAt(0).toUpperCase()}${partial.slice(1)}` %>
<section class="terminal-block" aria-labelledby="block-<%= partial %>">
  <div class="block-prompt"><span class="prompt-path"><%- await include('partials/_icon.ejs', {name:'file-directory'}) %> ~/<%= q.repo ? `${user.login}/${q.repo}` : user.login %></span></div>
  <h2 id="block-<%= partial %>" class="block-command"><span class="prompt-chevron" aria-hidden="true">❯</span><%- await include('partials/_icon.ejs', {name:partial === 'base.header' ? q.repo ? 'repo' : 'person' : {languages:'code', code:'code', lines:'code', tokscale:'cpu', music:'play', wakatime:'clock', habits:'clock', contributors:'person', people:'person', 'base.repositories':'repo', repositories:'repo', stars:'repo', starlists:'repo'}[partial] || 'graph'}) %><span class="command-name">metrics</span> <span class="command-argument"><%= partial === 'base.header' ? q.repo ? 'repository' : account === 'organization' ? 'organization' : 'profile' : partial.replace(/^base\./, '').replaceAll('+', ' ') %></span><span class="section-label"><%= title %></span></h2>
  <div class="terminal-output"><%- content %></div>
</section>
<% } %>

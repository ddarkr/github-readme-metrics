<% if (plugins["screenshot"]) { %>
<% if (plugins["screenshot"].error) { %>
<p class="error"><%= plugins["screenshot"].error.message %></p>
<% } else { %>
<p class="terminal-subtitle"><%= plugins.screenshot.title %></p>
<% if (plugins.screenshot.image) { %>
<img class="report-image" src="<%= plugins.screenshot.image %>" width="<%= plugins.screenshot.width %>" height="<%= plugins.screenshot.height %>" alt="<%= plugins.screenshot.title %>"/>
<% } else if (plugins.screenshot.content) { %><pre><%= plugins.screenshot.content %></pre>
<% } else { %><p class="empty">No content captured from the configured source.</p><% } %>
<% } %>
<% } %>

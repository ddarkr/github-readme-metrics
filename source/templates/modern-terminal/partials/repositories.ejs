<% if (plugins.repositories) { %>
  <% if (plugins.repositories.error) { -%>
    <span class="error"><%= plugins.repositories.error.message %></span>
  <% } else { const list = plugins.repositories.list ?? [] -%>
    <% if (list.length) { -%>
      <ul class="terminal-list">
      <% for (const repository of list) { -%>
        <li><div><%= repository.nameWithOwner || repository.name || "unknown" %> <span class="tui-status">★ <%= f(repository.stargazerCount) %></span> <span class="tui-status">⑂ <%= f(repository.forkCount) %></span></div>
        <% if (repository.description) { %><div class="tui-detail"><%= String(repository.description).trim() %></div><% } %>
        <% if (repository.primaryLanguage?.name) { %><div class="tui-detail"><span style="--data-color:<%= repository.primaryLanguage.color ?? 'var(--color-muted)' %>;color:var(--data-color)"><%= repository.primaryLanguage.name %></span></div><% } %>
        </li>
      <% } -%>
      </ul>
    <% } else { -%>
      <p class="empty">No featured repositories configured</p>
    <% } -%>
  <% } -%>
<% } %>

<% if (plugins.isocalendar) { %>

  <% if (plugins.isocalendar.error) { -%>
    <span class="error"><%= plugins.isocalendar.error.message %></span>
  <% } else { -%>
    <div class="terminal-kv">
      <% if (plugins.isocalendar.streak.current) { %><span class="terminal-kv__key">Current streak</span><span class="terminal-kv__value"><%= plugins.isocalendar.streak.current %> day<%= s(plugins.isocalendar.streak.current) %></span><% } %>
      <span class="terminal-kv__key">Best streak</span><span class="terminal-kv__value"><%= plugins.isocalendar.streak.max %> day<%= s(plugins.isocalendar.streak.max) %></span>
      <span class="terminal-kv__key">Highest day</span><span class="terminal-kv__value"><%= plugins.isocalendar.max %></span>
      <span class="terminal-kv__key">Daily average</span><span class="terminal-kv__value"><%= plugins.isocalendar.average %></span>
    </div>
    <% if (plugins.isocalendar.svg) { %><div class="report-chart"><%- plugins.isocalendar.svg %></div><% } %>
  <% } -%>

<% } %>

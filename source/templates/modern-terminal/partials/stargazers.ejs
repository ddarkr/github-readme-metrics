<% if (plugins.stargazers) { %>
<div class="stdin"><%- meta.$ %> stargazers</div><%# -%>
<div class="stdout"><%# -%>
<% if (plugins.stargazers.error) { -%>
<span class="error"><%= plugins.stargazers.error.message %></span><%# -%>
<% } else { -%>
<% const s = plugins.stargazers %>
<% const total = s.total?.count || 0 %>
<%= ("TOTAL".padEnd(12) + String(total).padStart(8)) %>
<% if (s.increments && s.increments.max != null) { %>
<%= ("MAX/INCR".padEnd(12) + String(s.increments.max || 0).padStart(8)) %>
<% } %>
<% if (s.months) { %>
<%= ("MONTHS".padEnd(12) + Object.keys(s.months).length.toString().padStart(8)) %>
<% } %>

<% if (s.charts && Array.isArray(s.charts)) { %>
<%= ("CHARTS".padEnd(12) + "rendered".padStart(8)) %>
<% } else if (s.total && s.total.dates) { %>
<%= ("CHART".padEnd(12) + "ascii".padStart(8)) %>
<% let prev=null; for (const [date,value] of Object.entries(s.total.dates)) { const bar = "#".repeat(Math.min(50, Math.round(50*((value - (s.total.min||0))/((s.total.max||1)-(s.total.min||0)||1)))) ) %>
<%= (date.padEnd(12) + String(value).padStart(6) + " " + bar) %>
<% prev = value } %>
<% } %>

<% if (s.worldmap) { %>
<%= ("ORIGINS".padEnd(12) + "available".padStart(8)) %>
<% } %>
<% } -%>
</div><% } %>

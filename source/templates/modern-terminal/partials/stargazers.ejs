<% if (plugins["stargazers"]) { %>
<% if (plugins["stargazers"].error) { %>
<p class="error"><%= plugins["stargazers"].error.message %></p>
<% } else { %>
<p><%= f(computed.repositories.stargazers) %> stargazers · last <%= plugins.stargazers.days %> days</p>
<% if (plugins.stargazers.charts) { %>
<% if (Array.isArray(plugins.stargazers.charts)) { %>
<% for (const [index, chart] of plugins.stargazers.charts.entries()) { %><h3><%= index === 0 ? "Total stargazers" : "New stargazers" %></h3><div class="report-chart"><%- chart %></div><% } %>
<% } else { %>
<div class="terminal-table"><div class="terminal-table__row terminal-subtitle"><span>Date</span><span>Total · new</span></div>
<% for (const [date, value] of Object.entries(plugins.stargazers.total.dates)) { %><div class="terminal-table__row"><span><%= date %></span><span><%= f(value) %> · +<%= f(plugins.stargazers.increments.dates[date]) %></span></div><% } %>
</div>
<% } %>
<% } %>
<% if (plugins.stargazers.worldmap) { %><h3>Stargazer locations</h3><div class="report-chart"><%- plugins.stargazers.worldmap %></div><% } %>
<% } %>
<% } %>

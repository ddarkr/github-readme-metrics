<% if (plugins.achievements) { %>
  <div class="stdin"><%- meta.$ %> gh achievement list --user <%= user.login %></div>
  <div class="stdout">
  <% if (plugins.achievements.error) { -%>
    <span class="error"><%= plugins.achievements.error.message %></span>
  <% } else { -%>
    <% const list = plugins.achievements.list ?? [];
       const RANK_W = 4;
       const TITLE_W = 48;
       const VALUE_W = 8;
       const TOTAL_W = RANK_W + 1 + TITLE_W + 1 + VALUE_W;
       const lines = [];
       // Header
       lines.push('Rk'.padEnd(RANK_W) + ' ' + 'Title'.padEnd(TITLE_W) + ' ' + 'Value'.padStart(VALUE_W));
       // Rows
       for (const {prefix = '', title = '', rank = '?', value = ''} of list) {
         const displayTitle = prefix && prefix.length ? (prefix + ' ' + title.charAt(0).toUpperCase() + title.slice(1)) : title;
         const displayValue = (typeof value === 'number') ? Math.floor(value) : (value ? value : '?');
         lines.push(String(rank).padEnd(RANK_W) + ' ' + String(displayTitle).padEnd(TITLE_W) + ' ' + String(displayValue).padStart(VALUE_W));
       }
    %><pre><%= lines.join('\n') %></pre><% } -%>
  </div>
<% } %>

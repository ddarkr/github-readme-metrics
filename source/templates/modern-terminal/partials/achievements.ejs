<% if (plugins["achievements"]) { %>
<% if (plugins["achievements"].error) { %>
<p class="error"><%= plugins["achievements"].error.message %></p>
<% } else { %>
<% if (plugins.achievements.list.length) { %><ul class="terminal-list">
<% for (const achievement of plugins.achievements.list) { %>
<li><div><%= achievement.prefix %> <%= achievement.title %> <span class="tui-status">rank <%= achievement.rank %></span><% if (plugins.achievements.display === "compact") { %> <span class="tui-status"><%= typeof achievement.value === "number" ? Math.floor(achievement.value) : achievement.value ? "Unlocked" : "Locked" %></span><% } %></div>
<div class="tui-detail"><%= achievement.text %></div>
<% if (achievement.leaderboard) { %><div class="tui-detail">ranked <%= f(achievement.leaderboard.user) %> of <%= f(achievement.leaderboard.total) %> <%= achievement.leaderboard.type %></div><% } %>
<% if (achievement.unlock) { %><div class="tui-detail">unlocked <%= achievement.unlock %></div><% } %>
</li><% } %></ul><% } else { %><p class="empty">No achievements matching the configured filters.</p><% } %>
<% } %>
<% } %>

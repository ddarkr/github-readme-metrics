<% if (plugins["calendar"]) { %>
<% if (plugins["calendar"].error) { %>
<p class="error"><%= plugins["calendar"].error.message %></p>
<% } else { let total = 0; let peak = 0; const years = []; for (const {year, weeks} of plugins.calendar.years) { let yearTotal = 0; for (const {contributionDays} of weeks) { for (const {contributionCount} of contributionDays) yearTotal += contributionCount; } total += yearTotal; peak = Math.max(peak, yearTotal); years.push({year, total: yearTotal}); } %>
<% if (years.length) { %>
<dl class="terminal-kv">
<dt>Total contributions</dt><dd><%= f(total) %></dd>
</dl>
<table class="tui-table tui-table--calendar">
<thead><tr><th scope="col">Year</th><th scope="col" class="tui-number">Contributions</th><% if (peak) { %><th scope="col">Relative to peak</th><% } %></tr></thead>
<tbody>
<% for (const {year, total: yearTotal} of years) { const filled = peak ? Math.round((yearTotal / peak) * 10) : 0; %>
<tr><th scope="row"><%= year %></th><td class="tui-number"><%= f(yearTotal) %></td><% if (peak) { %><td><span class="tui-bar" aria-hidden="true"><span><%= "█".repeat(filled) %></span><span class="tui-bar-empty"><%= "░".repeat(10 - filled) %></span></span></td><% } %></tr>
<% } %>
</tbody>
</table>
<% } else { %><p class="empty">No contribution history available.</p><% } %>
<% } %>
<% } %>

<% if (plugins.topics) { %>

  <% if (plugins.topics.error) { -%>
    <span class="error"><%= plugins.topics.error.message %></span>
  <% } else { const list = plugins.topics.list || []; const title = {starred: "Starred topics", labels: "Starred topics", icons: "Starred topics", mastered: "Mastered technologies and topics"}[plugins.topics.mode] ?? "Topics" -%>
    <div class="terminal-subtitle"><%= title %> · <%= list.length %></div>
    <div class="terminal-table">
    <% if (list.length) { -%>
      <% for (const [index, item] of list.entries()) { -%>
        <div class="terminal-table__row"><span class="terminal-table__label"><span style="color:var(--color-muted)"><%= index + 1 %>.</span> <%= (item.name || "").toLowerCase() %><% if (item.description) { %><br/><span style="color:var(--color-muted)"><%= item.description %></span><% } %></span><span class="terminal-table__value"></span></div>
      <% } -%>
    <% } else { -%>
      <span style="color:var(--color-muted)">No topics found</span>
    <% } -%>
    </div>
  <% } -%>

<% } %>

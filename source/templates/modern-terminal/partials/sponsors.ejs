<% if (plugins["sponsors"]) { %>
<% if (plugins["sponsors"].error) { %>
<p class="error"><%= plugins["sponsors"].error.message %></p>
<% } else { %>
<% for (const section of plugins.sponsors.sections) { %>
<% if (section === "about") { %><div class="prose"><%- plugins.sponsors.about %></div><% } %>
<% if (section === "goal" && plugins.sponsors.goal) { %>
<h3><%= plugins.sponsors.goal.title %></h3><p><%= plugins.sponsors.goal.description %></p><p><%= plugins.sponsors.goal.progress %>% funded</p>
<% } %>
<% if (section === "list" || section === "goal") { %>
<% if (section === "list" || !plugins.sponsors.sections.includes("list")) { %>
<p><%= f(plugins.sponsors.count.active.total) %> active sponsors</p>
<% } %>
<% } %>
<% if (section === "list") { %>
<ul class="terminal-list">
<% for (const person of plugins.sponsors.list.filter(person => !person.past || plugins.sponsors.past)) { %>
<li><%= person.private ? "Private sponsor" : person.login %><% if (person.past) { %> <span class="terminal-subtitle">past</span><% } %></li>
<% } %>
</ul>
<% if (!plugins.sponsors.list.length) { %><p class="empty">No sponsors to display.</p><% } %>
<% } %>
<% } %>
<% } %>
<% } %>

<% if (plugins.starlists) { %>
<% if (plugins.starlists.error) { -%>
<span class="error"><%= plugins.starlists.error.message %></span><%# -%>
<% } else { -%>
<ul class="terminal-list">
<% for (const {name, description, count, repositories = [], languages = null} of plugins.starlists.lists) { %>
<li><div><%= name || "Unnamed list" %> <span class="tui-status"><%= count %> repos</span></div>
<% if (description) { %><div class="tui-detail"><%= description %></div><% } %>
<% if (languages) { %>
<div class="tui-detail">Languages</div>
<table class="tui-table"><thead><tr><th scope="col">Language</th><th scope="col">Share</th><th scope="col">Stars</th></tr></thead><tbody>
<% for (const {name: langName, value} of languages) { %><tr><td><%= langName || "" %></td><td class="tui-number"><%= f.percentage(value/count) %></td><td class="tui-number"><%= f(value) %>★</td></tr><% } %>
</tbody></table>
<% } %>
<% if (repositories.length) { %><ul class="terminal-list">
<% for (const repo of repositories) { %>
<li><div><%= repo.name || "" %><% if (Number.isFinite(repo.stargazers)) { %> <span class="tui-status">★ <%= f(repo.stargazers) %></span><% } %><% if (Number.isFinite(repo.forks)) { %> <span class="tui-status">forks <%= f(repo.forks) %></span><% } %></div>
<% if (repo.language?.name) { %><div class="tui-detail"><%= repo.language.name %></div><% } %>
<% if (repo.description) { %><div class="tui-detail"><%= repo.description %></div><% } %>
</li>
<% } %>
</ul><% } %>
</li>
<% } %>
</ul>
<% } -%>
<% } %>

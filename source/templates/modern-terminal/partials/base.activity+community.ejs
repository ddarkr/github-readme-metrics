<% if ((!q.repo && account === "user")&&((base.activity)||(base.community))) { %>
<% if (base.activity) { %>
<h3>Recent activity</h3>
<dl class="terminal-kv">
<dt>Commits</dt><dd><%= computed.commits %></dd>
<dt>PRs reviewed</dt><dd><%= user.contributionsCollection.totalPullRequestReviewContributions %></dd>
<dt>PRs opened</dt><dd><%= user.contributionsCollection.totalPullRequestContributions %></dd>
<dt>Issues opened</dt><dd><%= user.contributionsCollection.totalIssueContributions %></dd>
<dt>Issue comments</dt><dd><%= user.issueComments.totalCount %></dd>
</dl>
<% } %>
<% if (base.community) { %>
<h3>Tracked activity</h3>
<dl class="terminal-kv">
<dt>Following</dt><dd><%= user.following.totalCount %></dd>
<dt>Repos sponsored</dt><dd><%= user.sponsorshipsAsSponsor.totalCount %></dd>
<dt>Repos starred</dt><dd><%= user.starredRepositories.totalCount %></dd>
<dt>Repos watched</dt><dd><%= user.watching.totalCount %></dd>
</dl>
<% } %>
<% } %>

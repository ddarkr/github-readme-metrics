<% if (plugins["code"]) { %>
<% if (plugins["code"].error) { %>
<p class="error"><%= plugins["code"].error.message %></p>
<% } else { %>
<% const {snippet} = plugins.code %>
<% if (snippet) { %>
<p><b><%= snippet.repo %></b> · <%= snippet.sha %></p>
<p class="terminal-subtitle"><%= f.date(snippet.created, {date:true, time:true, timeZone:config.timezone?.name}) %></p>
<p><%= snippet.message %></p>
<p><%= snippet.filename %> · <span class="diff">+<%= snippet.additions %></span> · <span class="deleted">-<%= snippet.deletions %></span></p>
<pre class="code"><code class="language-diff"><%- snippet.patch %></code></pre>
<% } else { %><p class="empty">No code matching the configured filters.</p><% } %>
<% } %>
<% } %>

<% if (plugins["sponsorships"]) { %>
<% if (plugins["sponsorships"].error) { %>
<p class="error"><%= plugins["sponsorships"].error.message %></p>
<% } else { %>
<% for (const section of plugins.sponsorships.sections) { %>
<% if (section === "amount") { %>
<p>Total given: <b><%= Number.isFinite(plugins.sponsorships.amount) ? new Intl.NumberFormat("en", {style:"currency", currency:"USD"}).format(plugins.sponsorships.amount) : "Unavailable" %></b></p>
<% if (plugins.sponsorships.started) { %><p class="terminal-subtitle">Since <%= f.date(plugins.sponsorships.started, {date:true, timeZone:config.timezone?.name}) %></p><% } %>
<% } else if (section === "sponsorships") { %>
<p><%= plugins.sponsorships.list.length %> recipients</p>
<ul class="terminal-list">
<% for (const recipient of plugins.sponsorships.list) { %>
<li><%= recipient.login %><span class="terminal-subtitle"> · <%= recipient.past ? "past" : "current" %></span></li>
<% } %>
</ul>
<% } %>
<% } %>
<% } %>
<% } %>

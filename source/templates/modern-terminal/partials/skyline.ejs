<% if (plugins.skyline) { %>
<div class="stdin"><%- meta.$ %> skyline render</div><%# -%>
<div class="stdout"><%# -%>
<% if (plugins.skyline.error) { -%>
<span class="error"><%= plugins.skyline.error.message %></span><%# -%>
<% } else { -%>
  <% if (plugins.skyline.compatibility) { -%>
    <% const n = plugins.skyline.animation?.length || 0; -%>
    Skyline frames: <%= n %> frame<%= n===1 ? '' : 's' %>
    Width: <%= plugins.skyline.width %>px, Height: <%= plugins.skyline.height %>px
    <% if (n) { -%>
      <% for (let i=0;i<n;i++) { -%>
        frame <%= String(i+1).padStart(2,' ') %>: <%= plugins.skyline.animation[i] %>
      <% } -%>
    <% } -%>
  <% } else { -%>
    single skyline image: <%= plugins.skyline.animation %>
  <% } -%>
<% } -%>
</div><% } %>

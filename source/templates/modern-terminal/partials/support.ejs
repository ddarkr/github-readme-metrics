<% if (plugins["support"]) { %>
<% if (plugins["support"].error) { %>
<p class="error"><%= plugins["support"].error.message %></p>
<% } else { %>
<dl class="terminal-kv">
<dt>Hearts received</dt><dd><%= f(plugins.support.stats.hearts) %></dd>
<dt>Topics created</dt><dd><%= f(plugins.support.stats.topics) %></dd>
<dt>Posts</dt><dd><%= f(plugins.support.stats.posts) %></dd>
<dt>Solutions</dt><dd><%= f(plugins.support.stats.solutions) %></dd>
<dt>Badges</dt><dd><%= f(plugins.support.badges.count) %></dd>
</dl>
<% } %>
<% } %>

<% if (plugins.support) { %>
<div class="stdin"><%- meta.$ %> support</div><%# -%>
<div class="stdout"><%# -%>
<% if (plugins.support.error) { -%>
<span class="error"><%= plugins.support.error.message %></span><%# -%>
<% } else { -%>
<% const stats = plugins.support.stats || {} %>
<% const badges = plugins.support.badges || {} %>
<%= ("Hearts:").padEnd(12) + String(stats.hearts || 0).padStart(6) + "  received" %><%# -%>
<%= ("Topics:").padEnd(12) + String(stats.topics || 0).padStart(6) + "  created" %><%# -%>
<%= ("Posts:").padEnd(12) + String(stats.posts || 0).padStart(6) %><%# -%>
<%= ("Badges:").padEnd(12) + String(badges.count || 0).padStart(6) %><%# -%>
<%= ("Solutions:").padEnd(12) + String(stats.solutions || 0).padStart(6) %><%# -%>
<% } -%>
</div><% } %>

<% if (plugins["projects"]) { %>
<% if (plugins["projects"].error) { %>
<p class="error"><%= plugins["projects"].error.message %></p>
<% } else { %>
<div class="terminal-kv"><span class="terminal-kv__key">Projects</span><span class="terminal-kv__value tui-number"><%= plugins.projects.totalCount %></span></div>
<% if (plugins.projects.list.length) { %>
<ul class="terminal-list">
<% for (const {name, updated, description, progress, items = []} of plugins.projects.list) { %>
<li><div><%= name %> <span class="tui-status">updated <%= updated %></span></div>
<% if (plugins.projects.descriptions && description) { %><div class="tui-detail"><%= description %></div><% } %>
<% if (progress.enabled) { %><div class="tui-detail"><span class="tui-status"><%= progress.done %> done</span> <span class="tui-status"><%= progress.doing %> in progress</span> <span class="tui-status"><%= progress.todo %> to do</span></div><% } %>
<% if (items.length) { %><ul class="terminal-list"><% for (const {type, text} of items) { %><li><span class="tui-status"><%= type.toLowerCase().replaceAll("_", " ") %></span> <%= text %></li><% } %></ul><% } %>
</li>
<% } %>
</ul>
<% } else { %><p class="empty">No projects matching the configured selection.</p><% } %>
<% } %>
<% } %>

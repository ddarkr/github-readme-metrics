<% if (plugins.reactions) { %>
<div class="stdin"><%- meta.$ %> reactions --comments <%= plugins.reactions?.comments %></div><%# -%>
<div class="stdout"><%# -%>
<% if (plugins.reactions.error) { -%>
<span class="error"><%= plugins.reactions.error.message %></span><%# -%>
<% } else { -%>
Overall reactions from last <%= plugins.reactions?.comments %> comments
<% const mapping = {HEART: '❤️', THUMBS_UP: '👍', THUMBS_DOWN: '👎', LAUGH: '😄', CONFUSED: '😕', EYES: '👀', ROCKET: '🚀', HOORAY: '🎉'}; %>
<% for (const [reaction, emoji] of Object.entries(mapping)) { const {score = 0, value:count = 0} = (plugins.reactions.list || {})[reaction] ?? {}; const pct = Math.round(score*100); const barLen = Math.round((score || 0) * 20); const bar = '█'.repeat(barLen).padEnd(20, ' '); %>
<%= emoji %>  <%= reaction.padEnd(12, ' ') %>  <%= `${count}`.padStart(4, ' ') %>  <%= `${pct}%`.padStart(4, ' ') %>  | <span style="color:#ffd33d"><%= bar %></span>
<% if (Array.isArray(plugins.reactions.details) && plugins.reactions.details.length) { const [primary, secondary] = plugins.reactions.details; %>
  Details: <% if (primary === 'count') { %><%= count %><% } else { %><%= pct %>%<% } %><% if (secondary) { %> (<% if (secondary === 'count') { %><%= count %><% } else { %><%= pct %>%<% } %>)<% } %>
<% } %>
<% } %>
<% } -%>
</div><% } %>

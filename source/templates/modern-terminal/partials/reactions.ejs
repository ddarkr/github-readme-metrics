<% if (plugins["reactions"]) { %>
<% if (plugins["reactions"].error) { %>
<p class="error"><%= plugins["reactions"].error.message %></p>
<% } else { %>
<p><%= plugins.reactions.total %> reactions from <%= plugins.reactions.comments %> comments</p>
<div class="terminal-table">
<% for (const [key, label] of Object.entries({HEART:"Heart", THUMBS_UP:"Thumbs up", THUMBS_DOWN:"Thumbs down", LAUGH:"Laugh", CONFUSED:"Confused", EYES:"Eyes", ROCKET:"Rocket", HOORAY:"Hooray"})) { const {percentage = 0, value = 0} = plugins.reactions.list[key] || {} %>
<div class="terminal-table__row"><span><%= label %></span><span><%= plugins.reactions.details.map(detail => detail === "count" ? f(value) : f.percentage(percentage)).join(" · ") %></span></div>
<% } %>
</div>
<% } %>
<% } %>

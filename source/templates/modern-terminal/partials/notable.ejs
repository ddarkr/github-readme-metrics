<% if (plugins["notable"]) { %>
<% if (plugins["notable"].error) { %>
<p class="error"><%= plugins["notable"].error.message %></p>
<% } else { %>
<% if (plugins.notable.contributions.length) { %>
<ul class="terminal-list">
<% for (const {name, user: contribution} of plugins.notable.contributions) { %>
<li><div><%= name %><% if (contribution?.maintainer) { %> <span class="tui-status">maintainer</span><% } %></div>
<% if (contribution) { %>
<div class="tui-detail"><%= ["commits", "stars", "issues", "pulls"].filter(key => Number.isFinite(contribution[key])).map(key => `${f(contribution[key])} ${key === "pulls" ? "pull requests" : key}`).join(" · ") %></div>
<% } %>
</li>
<% } %>
</ul>
<% } else { %><p class="empty">No recent contributions matching the configured filters.</p><% } %>
<% } %>
<% } %>

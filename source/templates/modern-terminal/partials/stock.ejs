<% if (plugins["stock"]) { %>
<% if (plugins["stock"].error) { %>
<p class="error"><%= plugins["stock"].error.message %></p>
<% } else { %>
<dl class="terminal-kv">
<dt>Company</dt><dd><%= plugins.stock.company %></dd>
<dt>Symbol</dt><dd><%= plugins.stock.symbol %></dd>
<dt>Price</dt><dd><%= plugins.stock.price.toFixed(2) %> <%= plugins.stock.currency %></dd>
<dt>Period</dt><dd><%= {"1d":"Today", "5d":"Last five days", "1mo":"Last month", "3mo":"Last quarter", "6mo":"Last six months", "1y":"Last year", "2y":"Last two years", "5y":"Last five years", "10y":"Last ten years", ytd:"Year to date", max:"All time"}[plugins.stock.duration] %></dd>
<dt>Change</dt><dd><%= f(plugins.stock.delta, {sign:true, fixed:2}) %> <%= plugins.stock.currency %><% if (plugins.stock.previous) { %> · <%= f(100 * plugins.stock.delta / plugins.stock.previous, {sign:true, fixed:2}) %>%<% } %></dd>
</dl>
<div class="report-chart"><%- plugins.stock.chart %></div>
<% } %>
<% } %>
